    <!-- Sign-in -->
    <string name="signin_title">Sign in</string>
    <string name="signin_intro">On the CalZone website, open Devices and choose Show a sign-in code. Then scan it here, or open it with your camera app.</string>
    <string name="signin_scan">Scan the code</string>
    <string name="signin_scan_hint">Point the camera at the QR code on the Devices page.</string>
    <string name="signin_paste">Paste the address</string>
    <string name="signin_paste_hint">No camera? Copy the address under the code into this phone.</string>
    <string name="signin_paste_label">Sign-in address</string>
    <string name="signin_http_warning">This server does not use https. Use it only on your own network.</string>
    <string name="signin_continue">Sign in</string>
    <string name="signin_not_ours">That is not a CalZone sign-in code.</string>
    <string name="signin_used_up">This code is used up or has expired. Show a new one on the Devices page.</string>
    <string name="signin_offline">The server could not be reached. Check the address and that this phone is online.</string>
    <string name="signin_other">Signing in did not work. Try a new code.</string>

    <!-- Home -->
    <string name="home_who">%1$s on %2$s</string>
    <string name="home_device">This phone: %1$s</string>
    <string name="network_off_title">CalZone cannot reach the network</string>
    <string name="network_off_body">Android shows CalZone no network, so it holds every sync without saying so. If other apps are online, turn on CalZone\'s Network permission in its app settings.</string>
    <string name="network_open_settings">Open app settings</string>
    <string name="signed_out_title">This phone was signed out</string>
    <string name="signed_out_body">The server no longer knows this phone (it was removed on the Devices page, or the account was disabled). Your changes on this phone are kept; sign in again to send them.</string>
    <string name="sign_in_again">Sign in again</string>
    <string name="access_title">Show CalZone in your other apps</string>
    <string name="access_body">Allow access to your calendar and contacts so Fossify, widgets, Contacts, the phone app and messengers show your CalZone calendars and address books. What you change there comes back to CalZone.</string>
    <string name="access_allow">Allow</string>

